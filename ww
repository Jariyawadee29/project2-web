<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">

    <!-- ทำให้เว็บแสดงผลบนมือถือได้ -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lanna Eats | อาหารเหนือสไตล์ล้านนา</title>

    <style>

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;

            /* ป้องกัน Browser จำตำแหน่ง Scroll เดิม */
            scroll-padding-top: 80px;
        }

        body {
            font-family:
                Arial,
                "Noto Sans Thai",
                sans-serif;

            background: #fffaf3;
            color: #2f241f;
            line-height: 1.6;
        }

        img {
            width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
        }


        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(47, 36, 31, 0.96);
            backdrop-filter: blur(10px);

            color: white;
        }

        .nav-container {
            width: 90%;
            max-width: 1200px;

            margin: auto;

            height: 70px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #f5bd52;
        }

        .nav-menu {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-menu a {
            color: white;
            font-weight: 500;
        }

        .nav-menu a:hover {
            color: #f5bd52;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 650px;

            display: flex;
            align-items: center;

            background:
                linear-gradient(
                    rgba(70, 35, 23, 0.72),
                    rgba(70, 35, 23, 0.72)
                ),
                url("images/hero.jpg");

            background-size: cover;
            background-position: center;

            color: white;
        }

        .hero-container {
            width: 90%;
            max-width: 1200px;

            margin: auto;
        }

        .hero-content {
            max-width: 700px;
        }

        .small-title {
            color: #f5bd52;

            font-size: 15px;
            font-weight: bold;

            letter-spacing: 3px;

            margin-bottom: 15px;
        }

        .hero h1 {
            font-size: clamp(42px, 7vw, 75px);

            line-height: 1.1;

            margin-bottom: 25px;
        }

        .hero p {
            font-size: 20px;

            max-width: 650px;

            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;

            padding: 14px 30px;

            background: #f5bd52;
            color: #2f241f;

            border-radius: 30px;

            font-weight: bold;

            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-3px);

            background: #ffd477;
        }


        /* =========================
           SECTION
        ========================= */

        .section {
            width: 90%;
            max-width: 1200px;

            margin: auto;

            padding: 90px 0;
        }

        .section-title {
            text-align: center;

            margin-bottom: 50px;
        }

        .section-title span {
            color: #a45332;

            font-weight: bold;

            letter-spacing: 2px;
        }

        .section-title h2 {
            font-size: 42px;

            margin: 10px 0;
        }

        .section-title p {
            color: #777;
        }


        /* =========================
           MENU
        ========================= */

        .menu-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 25px;
        }

        .menu-card {

            background: white;

            border-radius: 18px;

            overflow: hidden;

            box-shadow:
                0 8px 25px rgba(0,0,0,0.08);

            transition: 0.3s;
        }

        .menu-card:hover {

            transform: translateY(-7px);

            box-shadow:
                0 15px 35px rgba(0,0,0,0.13);
        }


        /* รูปอาหาร */

        .menu-image {

            width: 100%;

            height: 220px;

            object-fit: cover;

            background: #ead6b8;
        }


        /* ถ้ายังไม่มีรูป */

        .image-placeholder {

            height: 220px;

            background: #ead6b8;

            display: flex;

            justify-content: center;

            align-items: center;

            font-size: 70px;
        }


        .menu-info {

            padding: 22px;
        }

        .menu-name {

            font-size: 22px;

            font-weight: bold;

            margin-bottom: 3px;
        }

        .menu-english {

            color: #999;

            font-size: 14px;

            margin-bottom: 12px;
        }

        .menu-description {

            color: #666;

            font-size: 15px;

            min-height: 48px;

            margin-bottom: 15px;
        }

        .menu-bottom {

            display: flex;

            justify-content: space-between;

            align-items: center;
        }

        .price {

            color: #a45332;

            font-size: 22px;

            font-weight: bold;
        }

        .order-small {

            background: #a45332;

            color: white;

            padding: 8px 15px;

            border-radius: 20px;

            font-size: 14px;

            font-weight: bold;
        }


        /* =========================
           ABOUT
        ========================= */

        .about {

            background: #f2e3ce;
        }

        .about-container {

            width: 90%;

            max-width: 1100px;

            margin: auto;

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 50px;

            align-items: center;
        }

        .about-image {

            height: 400px;

            object-fit: cover;

            border-radius: 20px;
        }

        .about-content h2 {

            font-size: 40px;

            margin-bottom: 20px;
        }

        .about-content p {

            color: #665b53;

            margin-bottom: 15px;
        }


        /* =========================
           ORDER
        ========================= */

