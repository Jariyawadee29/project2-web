                min-height: 600px;
            }

            .hero-content {
                padding: 70px 0;
            }

            section {
                padding: 60px 0;
            }

            .menu-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .about-grid {
                grid-template-columns: 1fr;
            }

