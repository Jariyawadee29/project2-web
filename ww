            background: #1a0f09;

            color: white;

            text-align: center;

            padding: 26px;
        }

        footer .logo {
            margin-bottom: 5px;
        }

        footer p {
            color: #bca99a;

            font-size: 13px;
        }


        /* =========================
           TABLET
        ========================= */

        @media (max-width: 1000px) {

            .menu-grid {
                grid-template-columns:
                    repeat(3, 1fr);
            }

        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            .nav-inner {
                height: 60px;
            }

