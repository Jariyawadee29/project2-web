<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lanna Eats | อาหารเหนือสไตล์ล้านนา</title>

    <style>

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 75px;
        }

        body {
            font-family: Arial, "Noto Sans Thai", sans-serif;
            background: #fff8ed;
            color: #3b261b;
            line-height: 1.6;
        }

        img {
            width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
        }

        .container {
            width: 92%;
            max-width: 1180px;
            margin: auto;
        }


        /* =========================
           NAVBAR
        ========================= */

        nav {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: #24150d;
            color: white;

            border-bottom: 1px solid #c99532;
        }

        .nav-inner {
            height: 70px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 25px;
            font-weight: 800;
            color: #e8b449;
        }

        .nav-links {
            display: flex;
            gap: 28px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: #e8b449;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 570px;

            display: flex;
            align-items: center;

            background:
                linear-gradient(
                    90deg,
                    rgba(35, 18, 10, 0.92),
                    rgba(35, 18, 10, 0.52)
                ),
                url("images/hero.jpg");

            background-position: center;
            background-size: cover;

            color: white;
        }

        .hero-content {
            padding: 90px 0;
            max-width: 680px;
        }

        .kicker {
            color: #f1b83d;

            font-weight: 800;
            letter-spacing: 2px;

            margin-bottom: 12px;
        }

        .hero h1 {
            font-size: clamp(44px, 7vw, 78px);

            line-height: 1.05;

            margin-bottom: 16px;
        }

        .hero h2 {
            font-size: clamp(22px, 3vw, 34px);

            color: #f2bd4b;

            margin-bottom: 18px;
        }

        .hero p {
            font-size: 18px;

            max-width: 620px;

            margin-bottom: 28px;
        }

        .btn {
            display: inline-block;

            padding: 13px 25px;

            border-radius: 30px;

            background: #e8ad35;
            color: #28180e;

            font-weight: 800;

            transition: 0.3s;
        }

        .btn:hover {
            background: #ffd16a;

            transform: translateY(-2px);
        }


        /* =========================
           SECTION
        ========================= */

        section {
            padding: 80px 0;
        }

        .section-head {
            text-align: center;

            margin-bottom: 38px;
        }

        .section-head .label {
            color: #a55b2f;

            font-weight: 800;

            letter-spacing: 2px;
        }

        .section-head h2 {
            font-size: 40px;

            margin: 7px 0;
        }

        .section-head p {
            color: #75675d;
        }


        /* =========================
           MENU
        ========================= */

        .menu-grid {
            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 18px;
        }

        .card {
            background: white;

            border: 1px solid #eadbc5;

            border-radius: 14px;

            overflow: hidden;

            box-shadow:
                0 6px 18px rgba(65, 38, 18, 0.08);

            transition: 0.25s;
        }

        .card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 12px 25px rgba(65, 38, 18, 0.15);
        }

        .card img {
            height: 170px;

            object-fit: cover;
        }

        .card-body {
            padding: 16px;
        }

        .card h3 {
            font-size: 19px;

            margin-bottom: 2px;
        }

        .en {
            font-size: 13px;

            color: #a06a4d;

            margin-bottom: 10px;
        }

        .desc {
            font-size: 14px;

            color: #6e6259;

            min-height: 48px;
        }

        .price {
            font-size: 21px;

            font-weight: 800;

            color: #a94f25;

            margin-top: 12px;
        }

        .order {
            display: inline-block;

            margin-top: 10px;

            padding: 7px 13px;

            border-radius: 18px;

            background: #8d4929;
            color: white;

            font-size: 13px;

            font-weight: 700;
        }

        .order:hover {
            background: #b8663b;
        }


        /* =========================
           ABOUT
        ========================= */

        .about {
            background: #f1e2cd;
        }

        .about-grid {
            display: grid;

            grid-template-columns:
                1fr 1.2fr;

            gap: 45px;

            align-items: center;
        }

        .about-grid img {
            height: 330px;

            object-fit: cover;

            border-radius: 18px;
        }

        .about h2 {
            font-size: 38px;

            margin-bottom: 15px;
        }

        .about p {
            color: #685c52;

            margin-bottom: 12px;
        }


