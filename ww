            background: #2b180e;

            color: white;

            text-align: center;
        }

        .order-section h2 {
            font-size: 38px;
        }

        .order-section p {
            color: #d9c9bb;

            margin: 8px 0 22px;
        }

        .contact {
            display: flex;

            justify-content: center;

            gap: 15px;

            flex-wrap: wrap;

            margin-top: 22px;
        }

        .contact a {
            min-width: 190px;

            padding: 13px 18px;

            border: 1px solid #8d6947;

            border-radius: 10px;

            color: white;

            background: #3b2417;
        }

        .contact a:hover {
            background: #513222;
        }

        .contact small {
            display: block;

            color: #d5bfae;
        }


