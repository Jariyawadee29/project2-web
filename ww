            background:
                linear-gradient(
                    rgba(47,36,31,0.94),
                    rgba(47,36,31,0.94)
                );

            color: white;

            text-align: center;

            padding: 90px 20px;
        }

        .order h2 {

            font-size: 42px;

            margin-bottom: 15px;
        }

        .order p {

            color: #ddd;

            margin-bottom: 20px;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {

            background: #1e1713;

            color: white;

            padding: 30px 20px;

            text-align: center;
        }

        footer .logo {

            margin-bottom: 8px;
        }

        footer p {

            color: #aaa;

            font-size: 14px;
        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 900px) {

            .menu-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }

            .about-container {

                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 600px) {

            .nav-container {

                height: 60px;
            }

            .nav-menu {

                gap: 12px;

                font-size: 13px;
            }

            .hero {

                min-height: 600px;
            }

            .hero h1 {

                font-size: 43px;
            }

            .hero p {

                font-size: 17px;
            }

            .section {

                padding: 60px 0;
            }

            .section-title h2 {

                font-size: 32px;
            }

            .menu-grid {

                grid-template-columns: 1fr;
            }

